# Server timezone — the Calendar, sessions, and compensation periods all use
# JS's local-time Date methods (setHours, getDate, etc.) for day/week/month
# boundaries. Locally this "just works" because a developer's machine is
# usually already in the right timezone, but Render's containers default to
# UTC — without this set explicitly, the server computes day boundaries ~7
# hours off from the studio's real calendar day, so e.g. clicking a day in
# Calendar can silently miss sessions that belong to it. Already set in
# render.yaml for production; set here too so local dev matches even on a
# machine in a different timezone.
TZ="America/Tijuana"

# PostgreSQL connection string. Locally: `brew services start postgresql@16 && createdb rigoletto_dev`,
# then use your local Postgres role, e.g. postgresql://$(whoami)@localhost:5432/rigoletto_dev
# In production (Render): the Render-managed PostgreSQL connection string.
DATABASE_URL="postgresql://localhost:5432/rigoletto_dev"

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-real-secret"

# Required in production once a custom domain is attached (e.g. Render's
# generated *.onrender.com URL works without this, but a GoDaddy-managed
# custom domain behind Render's proxy needs it set explicitly).
# AUTH_URL="https://app.rigolettoprostudio.com"

# Optional — overrides the seeded passwords in prisma/seed.ts
# SEED_ADMIN_PASSWORD="..."
# SEED_TURI_PASSWORD="..."

# Optional — WhatsApp booking confirmations + inbound message log, via
# Meta's WhatsApp Cloud API directly (no BSP — needed for WhatsApp
# Coexistence, so the studio's real WhatsApp Business App keeps working on
# staff phones alongside these automated sends). Leave unset in dev;
# sessions still book normally, the confirmation just gets skipped instead
# of sent (see src/lib/services/whatsapp.ts). Requires a Meta Business
# Platform app, Coexistence onboarding (linking the existing WhatsApp
# Business App number), a permanent System User access token, and a
# Content Template approved via WhatsApp Manager (Utility category — see
# the plan doc for the suggested wording).
# WHATSAPP_ACCESS_TOKEN="..."
# WHATSAPP_PHONE_NUMBER_ID="..."
# WHATSAPP_BOOKING_TEMPLATE_NAME="session_booking_confirmation"
# WHATSAPP_BOOKING_TEMPLATE_LANG="es_MX"

# Required only for the inbound webhook (src/app/api/whatsapp/webhook/route.ts).
# WHATSAPP_WEBHOOK_VERIFY_TOKEN — any string you choose; enter the same
# value when configuring the webhook in Meta's App Dashboard.
# WHATSAPP_APP_SECRET — from the Meta app's Basic Settings, used to verify
# that inbound webhook requests genuinely came from Meta.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN="..."
# WHATSAPP_APP_SECRET="..."
